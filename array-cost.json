      "code": "const values = Array.from({length: 1024}, (_, index) => index); let total = 0; for (let repeat = 0; repeat < 4; repeat++) for (let index = 0; index < values.length; index++) { values[index]++; total += values[index] } return total;"
    },
    {
      "name": "array callback pipeline",
      "code": "const values = Array.from({length: 1024}, (_, index) => index); return values.map(value => value * 2).filter(value => value % 3 === 0).reduce((total, value) => total + value, 0);"
    },
    {
      "name": "sealed array writes",
      "code": "const values = Array.from({length: 1024}, (_, index) => index); Object.seal(values); let total = 0; for (let index = 0; index < values.length; index++) { values[index]++; total += values[index] } return total;"
    },
    {
      "name": "frozen array reads",
      "code": "const values = Object.freeze(Array.from({length: 1024}, (_, index) => index)); let total = 0; for (let index = 0; index < values.length; index++) total += values[index]; return total;"
    },
    {
      "name": "array mutators",
      "code": "const values = Array.from({length: 1024}, (_, index) => 1024 - index); values.sort((left, right) => left - right); values.reverse(); values.copyWithin(0, 512); values.fill(5, 512); return values.reduce((total, value) => total + value, 0);"
    }
