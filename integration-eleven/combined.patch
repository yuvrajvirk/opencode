+      const input = { 0: 2, 1: 4, length: { valueOf() { seen.push("length"); return 2.9 } } }
+      const mapped = Array.prototype.map.call(input, value => value + 1)
+      try { Array.prototype.map.call(input, null) } catch (error) { seen.push(error.name) }
+      return [mapped, seen]
+    `,
+  },
