+    code: `
+      const input = new Uint8Array([2, 4, 6])
+      const mapped = Array.prototype.filter.call(input, (value, index, receiver) => receiver === input && index > 0)
+      return [mapped, Array.isArray(mapped), Array.prototype.findLast.call(input, value => value < 6)]
+    `,
+  },
+  {
+    name: "read-only receivers and empty reductions match native behavior",
+    code: `
+      const input = Object.freeze({ 0: 9, length: "1" })
+      const output = Array.prototype.map.call(input, value => value)
+      try { Array.prototype.reduce.call({ length: 2 }, (sum, value) => sum + value) }
+      catch (error) { return [output, error.name] }
+    `,
+  },
+]
+
+describe("generic Array callback methods", () => {
+  for (const program of programs) {
+    test(program.name, async () => {
+      const expected = JSON.parse(JSON.stringify(new Function(`"use strict"; ${program.code}`)()))
+      const result = await Effect.runPromise(CodeMode.execute({ code: program.code, tools: {} }))
+      expect(result.ok).toBe(true)
+      if (result.ok) expect(result.value).toEqual(expected)
+    })
+  }
+
+  test("retains confinement limits and missing-await diagnostics", async () => {
+    for (const [code, message] of [
+      ["Array.prototype.map.call({ length: 10000001 }, value => value)", "Invalid array length"],
+      ["Array.prototype.map.call(Promise.resolve([1]), value => value)", "un-awaited Promise"],
+    ]) {
+      const result = await Effect.runPromise(CodeMode.execute({ code, tools: {} }))
+      expect(result.ok).toBe(false)
+      if (!result.ok) expect(result.error.message).toContain(message)
+    }
+  })
+})
diff --git a/packages/codemode/test/object-properties.test.ts b/packages/codemode/test/object-properties.test.ts
new file mode 100644
index 0000000000..5e8c5d1d1c
--- /dev/null
+++ b/packages/codemode/test/object-properties.test.ts
@@ -0,0 +1,152 @@
+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import { CodeMode } from "../src/index.js"
+
+const value = async (code: string) => {
+  const result = await Effect.runPromise(CodeMode.execute({ code, tools: {} }))
+  if (!result.ok) throw new Error(result.error.message)
+  return result.value
+}
+
+test("constructs hidden, immutable data properties without changing prototypes", async () => {
+  expect(
+    await value(`
+    const prototype = { inherited: true }
+    const target = Object.create(prototype, { field: { value: 7 } })
+    let immutable = false
+    try { target.field = 8 } catch (error) { immutable = error instanceof TypeError }
+    return [target.field, Object.keys(target), Object.getOwnPropertyNames(target), immutable, Object.getPrototypeOf(target) === prototype]
+  `),
+  ).toEqual([7, [], ["field"], true, true])
+})
+
+test("validates all property descriptions before making changes", async () => {
+  expect(
+    await value(`
+    const target = {}
+    try { Object.defineProperties(target, { first: { value: 1 }, second: null }) } catch {}
+    return Object.getOwnPropertyNames(target)
+  `),
+  ).toEqual([])
+})
+
+test("empty accessor descriptions do not require exposing a global object", async () => {
+  expect(
+    await value(`
+    const target = Object.create({}, { field: { set: this } })
+    const descriptor = Object.getOwnPropertyDescriptor(target, "field")
+    return [typeof this, typeof target.field, "set" in descriptor, descriptor.enumerable, descriptor.configurable]
+  `),
+  ).toEqual(["undefined", "undefined", true, false, false])
+})
+
+test("tracks per-index attributes through array mutations", async () => {
+  expect(
+    await value(`
+    const target = [1, 2, 3]
+    Object.defineProperty(target, "1", { value: 5, enumerable: false, writable: false })
+    let rejected = false
+    try { target.fill(9) } catch (error) { rejected = error instanceof TypeError }
+    return [target, Object.keys(target), Object.getOwnPropertyNames(target), rejected, Object.getOwnPropertyDescriptor(target, "1").writable]
+  `),
+  ).toEqual([[9, 5, 3], ["0", "2"], ["0", "1", "2", "length"], true, false])
+})
+
+test("array length conversion invokes program coercion twice", async () => {
+  expect(
+    await value(`
+    const target = [1, 2, 3]
+    let conversions = 0
+    Object.defineProperty(target, "length", { value: { valueOf() { conversions++; return 2 } } })
+    return [target, conversions]
+  `),
+  ).toEqual([[1, 2], 2])
+})
+
+test("byte descriptors update confined bytes through numeric conversion", async () => {
+  expect(
+    await value(`
+    const target = new Uint8Array([0])
+    let conversions = 0
+    Object.defineProperty(target, "0", { value: { valueOf() { conversions++; return 258 } } })
+    try { Object.defineProperty(target, "0", { configurable: false, value: { valueOf() { conversions++; return 4 } } }) } catch {}
+    return [target[0], conversions]
+  `),
+  ).toEqual([2, 1])
+})
+
+test("string inspection uses UTF-16 units and immutable index descriptors", async () => {
+  expect(
+    await value(`
+    const descriptors = Object.getOwnPropertyDescriptors("🐍")
+    return [Object.getOwnPropertyNames("🐍"), descriptors.length.value, descriptors[0].value.charCodeAt(0), descriptors[0].writable, descriptors[0].configurable]
+  `),
+  ).toEqual([["0", "1", "length"], 2, 0xd83d, false, false])
+})
+
+test("native accessor reflection exposes confined callables with stable identity", async () => {
+  expect(
+    await value(`
+    const getter = Object.getOwnPropertyDescriptor(Map.prototype, "size").get
+    const repeated = Object.getOwnPropertyDescriptor(Map.prototype, "size").get
+    return [typeof getter, getter === repeated, getter.call(new Map([["key", 1]]))]
+  `),
+  ).toEqual(["function", true, 1])
+})
+
+test("property inspection cannot reveal tool paths or pending promise internals", async () => {
+  for (const target of ["tools", "tools.private", "Promise.resolve(1)"]) {
+    for (const operation of [
+      `Object.getOwnPropertyNames(${target})`,
+      `Object.getOwnPropertyDescriptors(${target})`,
+      `Object.getOwnPropertyDescriptor(${target}, "path")`,
+    ]) {
+      const result = await Effect.runPromise(CodeMode.execute({ code: `return ${operation}`, tools: {} }))
+      expect(result.ok).toBe(false)
+      if (!result.ok) expect(result.error.message).toContain("awaited data object")
+    }
+  }
+})
+
+test("reflected native accessors retain receiver checks and confined constructors", async () => {
+  expect(
+    await value(`
+    const getter = Object.getOwnPropertyDescriptor(Map.prototype, "size").get
+    let rejected = 0
+    try { getter.call({}) } catch (error) { rejected += error instanceof TypeError ? 1 : 0 }
+    try { getter.constructor("return process")() } catch { rejected++ }
+    return [rejected, Object.getOwnPropertyNames(getter).sort(), typeof getter.call]
+  `),
+  ).toEqual([2, ["length", "name"], "function"])
+})
+
+test("single-property inspection does not enumerate a long primitive string", async () => {
+  expect(
+    await value(`
+    const text = "x".repeat(10000001)
+    const descriptor = Object.getOwnPropertyDescriptor(text, "length")
+    let bounded = false
+    try { Object.getOwnPropertyNames(text) } catch (error) { bounded = error instanceof RangeError }
+    return [descriptor.value, Object.getOwnPropertyDescriptor(text, "10000000").value, bounded]
+  `),
+  ).toEqual([10000001, "x", true])
+})
+
+test("data-property creation preserves cycle and array-size limits", async () => {
+  const circular = await Effect.runPromise(
+    CodeMode.execute({
+      code: `const target = {}; Object.defineProperty(target, "self", { value: target })`,
+      tools: {},
+    }),
+  )
+  expect(circular.ok).toBe(false)
+  if (!circular.ok) expect(circular.error.message).toContain("circular")
+  expect(
+    await value(`
+    const target = []
+    let rejected = false
+    try { Object.defineProperty(target, "10000000", { value: 1 }) } catch (error) { rejected = error instanceof RangeError }
+    return [rejected, target.length]
+  `),
+  ).toEqual([true, 0])
+})
diff --git a/packages/codemode/test/openapi-form.test.ts b/packages/codemode/test/openapi-form.test.ts
new file mode 100644
index 0000000000..74b96b1c14
--- /dev/null
+++ b/packages/codemode/test/openapi-form.test.ts
@@ -0,0 +1,203 @@
+import { describe, expect, test } from "bun:test"
+import { Effect, Layer } from "effect"
+import { HttpClient, HttpClientResponse } from "effect/http"
+import { CodeMode, OpenAPI, Tool } from "../src/index.js"
+
+const mediaType = "application/x-www-form-urlencoded"
+const schema = {
+  type: "object",
+  properties: {
+    text: { type: "string" },
+    count: { type: "integer" },
+    enabled: { type: "boolean" },
+    tags: { type: "array", items: { type: "string" } },
+  },
+}
+
+function fixture(body: Record<string, unknown>, required = false) {
+  const requests: { headers: Record<string, string>; body: string | undefined }[] = []
+  const auth: string[] = []
+  const client = Layer.succeed(HttpClient.HttpClient)(
+    HttpClient.make((request) =>
+      Effect.sync(() => {
+        requests.push({
+          headers: { ...request.headers },
+          body: request.body._tag === "Uint8Array" ? new TextDecoder().decode(request.body.body) : undefined,
+        })
+        return HttpClientResponse.fromWeb(request, new Response("ok"))
+      }),
+    ),
+  )
+  const adapted = OpenAPI.fromSpec({
+    baseUrl: "https://capture.invalid",
+    spec: {
+      openapi: "3.1.0",
+      components: {
+        schemas: { Form: schema },
+        securitySchemes: { bearer: { type: "http", scheme: "bearer" } },
+      },
+      security: [{ bearer: [] }],
+      paths: {
+        "/submit": {
+          post: {
+            operationId: "submit",
+            requestBody: { required, content: body },
+            responses: { 200: { description: "Captured" } },
+          },
+        },
+      },
+    },
+    auth: {
+      resolve: ({ name }) =>
+        Effect.sync(() => {
+          auth.push(name)
+          return { type: "bearer" as const, token: "fixture" }
+        }),
+    },
+  })
+  const invoke = (input: unknown) => {
+    const tool = adapted.tools.submit
+    if (!Tool.isTool(tool)) throw new Error("No form tool generated")
+    return Effect.runPromise(tool.execute(input).pipe(Effect.provide(client)))
+  }
+  return { ...adapted, requests, auth, client, invoke }
+}
+
+describe("OpenAPI URL-encoded bodies", () => {
+  test("executes form tools from CodeMode with typed fields and repeated arrays", async () => {
+    const sample = fixture({ [mediaType]: { schema } })
+    const runtime = CodeMode.make({ tools: sample.tools })
+    const result = await Effect.runPromise(
+      runtime
+        .execute(
+          'await tools.submit({ body: { text: "hello +&=☃", count: 0, enabled: false, tags: ["one", "two"] } })',
+        )
+        .pipe(Effect.provide(sample.client)),
+    )
+    expect(result.ok).toBe(true)
+    expect(sample.requests).toHaveLength(1)
+    expect(sample.requests[0].headers["content-type"]).toBe(mediaType)
+    expect([...new URLSearchParams(sample.requests[0].body)]).toEqual([
+      ["text", "hello +&=☃"],
+      ["count", "0"],
+      ["enabled", "false"],
+      ["tags", "one"],
+      ["tags", "two"],
+    ])
+    expect(sample.auth).toEqual(["bearer"])
+  })
+
+  test("preserves reserved names, Unicode replacement, empty strings, and comma-delimited arrays", async () => {
+    const sample = fixture({ [mediaType]: { schema, encoding: { tags: { style: "form", explode: false } } } })
+    const body = Object.fromEntries([
+      ["text", " \ud800🧪~!*'()"],
+      ["__proto__", "safe"],
+      ["constructor", ""],
+      ["a&b=+", "value"],
+      ["tags", ["a,b", "c"]],
+    ])
+    await sample.invoke({ body })
+    const parameters = new URLSearchParams(sample.requests[0].body)
+    expect(parameters.get("text")).toBe(" �🧪~!*'()")
+    expect(parameters.get("__proto__")).toBe("safe")
+    expect(parameters.get("constructor")).toBe("")
+    expect(parameters.get("a&b=+")).toBe("value")
+    expect(parameters.getAll("tags")).toEqual(["a,b,c"])
+    expect([...parameters]).toHaveLength(5)
+  })
+
+  test("preserves optional omission and required empty bodies", async () => {
+    const optional = fixture({ [mediaType]: { schema } })
+    await optional.invoke({})
+    expect(optional.requests[0].body).toBeUndefined()
+    expect(optional.requests[0].headers["content-type"]).toBeUndefined()
+    const required = fixture(
+      { [mediaType]: { schema: { type: "object", properties: {}, additionalProperties: false } } },
+      true,
+    )
+    await required.invoke({})
+    expect(required.requests[0].body).toBe("")
+    expect(required.requests[0].headers["content-type"]).toBe(mediaType)
+  })
+
+  test("keeps flattened required fields and root schema references", async () => {
+    const flattened = fixture(
+      { [mediaType]: { schema: { ...schema, required: ["text"], additionalProperties: false } } },
+      true,
+    )
+    await expect(flattened.invoke({})).rejects.toThrow("Missing required body field")
+    expect(flattened.auth).toEqual([])
+    await flattened.invoke({ text: "value" })
+    expect(flattened.requests[0].body).toBe("text=value")
+    const referenced = fixture({ [mediaType]: { schema: { $ref: "#/components/schemas/Form" } } })
+    await referenced.invoke({ body: { count: 2 } })
+    expect(referenced.requests[0].body).toBe("count=2")
+  })
+
+  test("prefers JSON when both body formats are offered", async () => {
+    const sample = fixture({ [mediaType]: { schema }, "application/json": { schema } })
+    await sample.invoke({ body: { count: 2 } })
+    expect(sample.requests[0].headers["content-type"]).toBe("application/json")
+    expect(JSON.parse(sample.requests[0].body ?? "")).toEqual({ count: 2 })
+  })
+
+  test("does not silently JSON-encode object fields with their default content type", async () => {
+    const sample = fixture({
+      [mediaType]: {
+        schema: {
+          type: "object",
+          properties: { metadata: { type: "object", properties: { label: { type: "string" } } } },
+        },
+      },
+    })
+    await expect(sample.invoke({ body: { metadata: { label: "value" } } })).rejects.toThrow("unsupported value")
+    expect(sample.auth).toEqual([])
+    expect(sample.requests).toEqual([])
+  })
+
+  test.each(
+    [
+      null,
+      [],
+      "text",
+      { text: null },
+      { text: {} },
+      { tags: [["nested"]] },
+      { text: undefined },
+      { count: Infinity },
+      { count: NaN },
+    ].map((body) => ({ body })),
+  )("rejects unsupported values before auth and transport: %j", async (input) => {
+    const sample = fixture({ [mediaType]: { schema } })
+    await expect(sample.invoke(input)).rejects.toThrow("URL-encoded")
+    expect(sample.auth).toEqual([])
+    expect(sample.requests).toEqual([])
+  })
+
+  test.each([
+    { type: "array", items: { type: "string" } },
+    { properties: { text: { type: "string" } } },
+    { $ref: "#/components/schemas/Missing" },
+  ])("reports unsupported root schemas rather than guessing: %j", (schema) => {
+    const sample = fixture({ [mediaType]: { schema } })
+    expect(sample.skipped[0].reason).toBe("URL-encoded request body must be an object")
+    expect(sample.tools).toEqual({})
+  })
+
+  test.each(
+    [
+      { text: { style: "deepObject" } },
+      { text: { style: "pipeDelimited" } },
+      { text: { allowReserved: true } },
+      { text: { explode: "false" } },
+      { text: { contentType: "application/json" } },
+      { text: { contentType: "text/plain" } },
+      { text: null },
+      [],
+    ].map((encoding) => ({ encoding })),
+  )("reports unsupported encodings rather than emitting incorrect bodies: %j", (input) => {
+    const sample = fixture({ [mediaType]: { schema, encoding: input.encoding } })
+    expect(sample.skipped).toHaveLength(1)
+    expect(sample.tools).toEqual({})
+  })
+})
