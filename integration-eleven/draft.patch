+function createTextCache<Value>(weight: (key: string, value: Value) => number) {
+  const values = new Map<string, Value>()
+  let size = 0
+  const remove = (key: string) => {
+    const value = values.get(key)
+    if (value === undefined) return
+    size -= weight(key, value)
+    values.delete(key)
+  }
+  return {
+    get(key: string) {
+      const value = values.get(key)
+      if (value === undefined) return
+      values.delete(key)
+      values.set(key, value)
+      return value
+    },
+    set(key: string, value: Value) {
+      remove(key)
+      values.set(key, value)
+      size += weight(key, value)
+      while (size > textCacheLimit * draftTextChunk || values.size > textCacheLimit * 2)
+        remove(values.keys().next().value!)
+      return value
+    },
+    delete: remove,
+  }
+}
