+
+type Descriptor = {
+  value?: Value
+  writable?: boolean
+  enumerable?: boolean
+  configurable?: boolean
+  get?: undefined
+  set?: undefined
+}
+
+const source = <R>(ctx: Interpreter<R>, value: Value): Obj => {
+  if (value === null || value === undefined) throw typeError("Cannot convert undefined or null to object.")
+  if (value instanceof ToolReference || value instanceof PromiseObj) throw invalidData("Property inspection requires an awaited data object.")
+  if (value instanceof Obj) return value
+  const result = new Obj(typeof value === "string" ? ctx.builtins.String : ctx.builtins.Object)
+  if (typeof value !== "string") return result
+  for (let index = 0; index < value.length; index++) {
